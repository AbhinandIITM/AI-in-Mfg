# Digital Twin environment package. Use .venv/ or venv/ instead.
.env
.venv
venv/
env.bak/
venv.bak/

# The trained policies. The weights are binaries and stay out of the
# repository; every table and every figure of a run is committed.
# The primary production model is tracked so the Streamlit app can be deployed.
results/run_*/models/
!results/run_PPO_seed42/models/
!results/run_PPO_seed42/models/final_model.zip
!results/run_PPO_seed42/models/vecnormalize.pkl
results/workers/

